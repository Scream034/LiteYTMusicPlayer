<Project Sdk="Microsoft.NET.Sdk">

  <!--      ВЕРСИИ ПАКЕТОВ        -->
  <PropertyGroup Label="Package Versions">
    <AvaloniaVersion>12.1.1</AvaloniaVersion>

    <!--
      ReactiveUI.Avalonia 12.0.3 — согласована с веткой ReactiveUI 23.2.28.
      Внимание: линейка 12.1.x перешла на ReactiveUI 24.x (вырезаны System.Reactive и DynamicData).
    -->
    <ReactiveUIAvaloniaVersion>12.0.3</ReactiveUIAvaloniaVersion>

    <!-- Dev-инструменты -->
    <!--
      HotAvalonia 3.1.4 (18.07.2026) — версия актуальна, изменений не требуется.
      HotAvalonia.Fody внутри метапакета остался на 3.1.0 — это штатная ситуация.
    -->
    <HotAvaloniaVersion>3.1.4</HotAvaloniaVersion>

    <!-- Entity Framework Core: обновлено с 10.0.2 до 10.0.11 (патчи безопасности/багфиксы) -->
    <EfCoreVersion>10.0.11</EfCoreVersion>

    <!-- MVVM -->
    <!--
      ReactiveUI.SourceGenerators 3.2.0 (было 2.6.30) — compile-time замена ReactiveUI.Fody.
      Проверено на совместимость с ReactiveUI 23.2.28 (LMP.Core).
    -->
    <ReactiveUISourceGenVersion>3.2.0</ReactiveUISourceGenVersion>
    <CommunityToolkitMvvmVersion>8.4.2</CommunityToolkitMvvmVersion>

    <!-- Microsoft Extensions (совпадает с TFM): обновлено с 10.0.2 до 10.0.11 -->
    <MsExtVersion>10.0.11</MsExtVersion>

    <!-- AsyncImageLoader: 3.8.0 — последняя актуальная версия, Avalonia 12 support -->
    <AsyncImageLoaderVersion>3.8.0</AsyncImageLoaderVersion>
  </PropertyGroup>

  <!--   ОСНОВНЫЕ НАСТРОЙКИ       -->
  <PropertyGroup Label="Core Settings">
    <!-- В Release — без консольного окна, в Debug — с консолью для логов -->
    <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
    <OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>

    <!--
      net11.0 — preview (GA ожидается ноябрь 2026).
      Осознанный выбор: Runtime Async без EnablePreviewFeatures, JIT-улучшения.
    -->
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <RootNamespace>LMP</RootNamespace>
    <AssemblyName>LMP</AssemblyName>

    <!-- Исключаем папки субпроектов из корневого проекта на уровне файловой системы .NET -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Core/**;SharpJaad.AAC/**</DefaultItemExcludes>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>

    <!-- Компилируемые биндинги по умолчанию: быстрее + ошибки на этапе компиляции -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Нужно для низкоуровневых аудио-операций (PCM-буферы, нативный interop) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      CS0436: ReactiveUI.SourceGenerators генерирует ReactiveAttribute в каждом проекте.
      LMP видит свой + экспортированный из LMP.Core → конфликт типов (безопасен).
    -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>

    <!-- Lock-файл обязателен для cache: true в GitHub Actions CI -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!--   ОПТИМИЗАЦИЯ ПАМЯТИ / JIT -->
  <PropertyGroup Label="Runtime Tuning">
    <!--
      Workstation GC: меньше потребление RAM, лучше отзывчивость UI.
      Server GC предназначен для серверных сценариев — нам не нужен.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>

    <!-- Background (Concurrent) GC: сборка мусора не блокирует UI-поток -->
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>

    <!--
      Отдаём память ОС после GC-цикла.
      Для медиа-приложений с большими кэшами изображений/аудио — правильный выбор.
    -->
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>

    <!--
      Компактификация Large Object Heap при следующем GC-цикле.
      Борется с фрагментацией после выгрузки крупных аудио/картинок из памяти.
    -->
    <GCLargeObjectHeapCompactionMode>CompactOnce</GCLargeObjectHeapCompactionMode>

    <!--
      Tiered Compilation + Dynamic PGO:
      - Быстрый старт (QuickJit для "холодного" кода)
      - Авто-оптимизация горячих путей на лету (TieredPGO)
    -->
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!--   DEBUG КОНФИГУРАЦИЯ       -->
  <PropertyGroup Label="Debug" Condition="'$(Configuration)' == 'Debug'">
    <!-- Встроенные PDB + исходники: шаговая отладка без внешних файлов -->
    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>
    <Optimize>false</Optimize>

    <!-- Встроенный .NET Hot Reload -->
    <EnableHotReload>true</EnableHotReload>
    <HotReloadEnabled>true</HotReloadEnabled>

    <!-- HotAvalonia: живая перезагрузка XAML без перекомпиляции -->
    <HotAvalonia>true</HotAvalonia>
    <!-- Balanced = разумный баланс между скоростью обнаружения и нагрузкой на FS -->
    <HotAvaloniaMode>Balanced</HotAvaloniaMode>
  </PropertyGroup>

  <!--   RELEASE КОНФИГУРАЦИЯ     -->
  <PropertyGroup Label="Release" Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>

    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <DefaultItemExcludes>$(DefaultItemExcludes);UI/Features/Debug/**;Tests/**;Tools/**</DefaultItemExcludes>

    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <TrimmerRootDescriptor>trimming.xml</TrimmerRootDescriptor>

    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>

    <!-- Подавляет IL20xx warnings от Roslyn trim analyzer при build.
       ReactiveUI.WhenAnyValue фундаментально использует expression trees через рефлексию.
       Все затронутые типы сохранены в trimming.xml — runtime корректен. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>

    <!-- Подавляет IL20xx errors от ILLink при publish.
       Дублирует SuppressTrimAnalysisWarnings для publish-path (отдельный инструмент). -->
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Label="File Includes/Excludes">
    <AvaloniaResource Include="Assets/**" />
    <Content Include="Assets/app.ico" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <Content Include="Native/quickjs_bridge_debug.dll">
      <Link>quickjs_bridge.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Content Include="Native/quickjs_bridge_release.dll">
      <Link>quickjs_bridge.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup Label="Avalonia Core">
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Concentus.Native" Version="1.5.2" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="$(ReactiveUIAvaloniaVersion)" />
    <!-- Обновлено с 2.2.1 до 2.2.3 -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3"
      Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <!--
    HotAvalonia требует явного companion-reference на Avalonia.Markup.Xaml.Loader,
    чтобы runtime XAML-парсер совпадал с версией Avalonia, а не с более старой версией
    внутри самого HotAvalonia (который поддерживает все релизы начиная с Avalonia 11.0.0).
  -->
  <ItemGroup Label="Hot Reload" Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="HotAvalonia" Version="$(HotAvaloniaVersion)" PrivateAssets="All" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="$(AvaloniaVersion)"
      PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Label="Avalonia Community">
    <!--
      Avalonia.Controls.ItemsRepeater официально retired начиная с Avalonia 12.
      Версии 12.1.x не существует; пакет заморожен на 12.0.0 (подтверждено на NuGet).
      Constraint "Avalonia >= 12.0.0" покрывает 12.1.x — совместимость сохранена.
      Удаление невозможно: ItemsRepeater активно используется в TrackListControl и PlaylistCoverPicker.
    -->
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
    <!--
      Xaml.Behaviors.Avalonia — актуальное имя пакета (старый Avalonia.Xaml.Behaviors deprecated).
      Версия 12.0.0 согласована с той же линейкой, что ItemsRepeater.
    -->
    <PackageReference Include="Xaml.Behaviors.Avalonia" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup Label="MVVM">
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(CommunityToolkitMvvmVersion)" />
    <!--
      ReactiveUI.SourceGenerators 3.2.0 — compile-time замена ReactiveUI.Fody.
      PrivateAssets="all": генератор не попадает в transitive-зависимости потребителей.
    -->
    <PackageReference Include="ReactiveUI.SourceGenerators" Version="$(ReactiveUISourceGenVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Label="UI Utilities">
    <PackageReference Include="AsyncImageLoader.Avalonia" Version="$(AsyncImageLoaderVersion)" />
  </ItemGroup>

  <ItemGroup Label="Linux Interop">
    <!-- Обновлено с 0.94.1 до 0.95.0 -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core/LMP.Core.csproj" />
  </ItemGroup>

</Project>